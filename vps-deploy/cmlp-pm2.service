# /etc/systemd/system/cmlp-pm2.service
# PM2 + Infisical dla CMLP na VPS. Wstrzykuje sekrety z Infisical do
# procesów wskrzeszanych przez PM2 (odporne na reboot). Instrukcja: HANDBOOK §15.
#
#   cp vps-deploy/cmlp-pm2.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now cmlp-pm2

[Unit]
Description=CMLP licensing platform (PM2, secrets via Infisical)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/opt/cmlp
# INFISICAL_TOKEN (machine identity, universal-auth):
EnvironmentFile=/etc/cmlp.infisical.env
Environment=PM2_HOME=/root/.pm2
ExecStart=/usr/bin/infisical run --env=prod --path=/ -- /usr/bin/pm2 resurrect
ExecReload=/usr/bin/infisical run --env=prod --path=/ -- /usr/bin/pm2 reload all --update-env
ExecStop=/usr/bin/pm2 kill
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
